# Supabase local + function secrets. Copy to `supabase/.env` (git-ignored). NEVER commit real values.

# Local dev keys are printed by `supabase start` (safe to use locally only).
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
# SERVICE ROLE: server/edge only. NEVER ship to a client. NEVER prefix with EXPO_PUBLIC_/NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Verified nutrition provider (Phase 3). Server-side only — clients call our edge function.
USDA_FDC_API_KEY=

# AI provider for meal-plan IDEAS (Phase 8). Server-side only. AI never sets nutrition numbers.
AI_PROVIDER_API_KEY=
