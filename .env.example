# =============================================================================
# Challenge42 — Root environment example
# =============================================================================
# This file documents the *shared* configuration boundary for the monorepo.
# Copy per-app examples into the app that needs them:
#   apps/mobile/.env.example   -> apps/mobile/.env
#   apps/admin/.env.example    -> apps/admin/.env.local
#   supabase/.env.example      -> supabase/.env
#
# NEVER commit real values. NEVER put a service-role key in a client app.
# =============================================================================

# ---- Runtime mode -----------------------------------------------------------
# When APP_ENV=development the mobile app uses local seed/mock adapters and does
# NOT require a live Supabase project. This lets Phase One run with zero secrets.
APP_ENV=development
