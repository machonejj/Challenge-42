# Admin app env. Copy to apps/admin/.env.local (git-ignored). NEVER commit real values.

# Public (browser) — safe to expose; RLS is the real guard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. Used only in route handlers / server actions. NEVER prefix with NEXT_PUBLIC_.
# This key bypasses RLS — it must never reach the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=
