{
  "expo": {
    "name": "Challenge42",
    "slug": "jake-m",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "challenge42",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMotionUsageDescription": "Challenge42 reads your step count to track your daily movement for the challenge."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#12382B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.ACTIVITY_RECOGNITION"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#12382B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Challenge42 reads your step count to track your daily movement for the challenge."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "102c0a8c-8899-4b18-bc6e-16e590e97efd"
      }
    },
    "owner": "jakemanson5s-team"
  }
}
