# Mobile app env. Copy to apps/mobile/.env. Only EXPO_PUBLIC_* vars reach the client bundle (public
# by design — RLS is the real security boundary; never put a service-role key here).

# Phase One runs entirely on the in-app mock data source, so these are OPTIONAL until Phase 2+.
EXPO_PUBLIC_DATA_SOURCE=mock
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
